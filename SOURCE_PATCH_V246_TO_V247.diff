+        adapter.telemetry = control.telemetry
+        return adapter
+
+    monkeypatch.setattr(module, "VisumAdapter", construct)
+
+    def native_save(visum, path):
+        cp = adapter.save(path)
+        visum.IO.CurrentVersionFile = str(path)
+        return cp
