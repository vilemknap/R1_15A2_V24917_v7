+        digest and explicitly listed consumer-module hashes may differ, and both the
+        predecessor release and every predecessor hash are pinned in the target
+        configuration.  The cache stays immutable and is still subjected to SQLite,
+        SHA-256, basis, comparison-basis and structure-hash readback checks.
+        """
+        rule = self.options.get("explicit_predecessor_read_compatibility", {})
+        if rule.get("enabled") is not True:
+            return None
+        if self.cfg.get("release") != rule.get("target_release"):
+            return None
+        predecessors = rule.get("predecessors")
+        if not isinstance(predecessors, list):
+            return None
+        source = None
+        for candidate in predecessors:
+            if (isinstance(candidate, dict) and
+                    manifest.get("release") == candidate.get("source_release") and
+                    actual.get("config_sha256") == candidate.get("source_config_sha256")):
+                source = candidate
