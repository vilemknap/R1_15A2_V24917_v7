@@ -0,0 +1,169 @@
+# -*- coding: utf-8 -*-
+"""V2.4.9.12 baseline-relative calibration severity policy.
+
+This module changes only the *interpretation* of the V2496 exploratory
+severity diagnostics.  Technical/model-state integrity, observation authority,
+protected-profile, native-IPF, rollback and parameter-envelope contracts stay
+fail-closed in their existing owners.
+
+The key correction is that an already-poor baseline is not an absolute veto.
+GEH threshold crossings are diagnostics/budgets; only material profile damage
+remains a per-profile hard stop.
+"""
+from __future__ import annotations
+
+from copy import deepcopy
+from typing import Any, Dict, List, Mapping
+
+POLICY_ID = "V24912_BASELINE_RELATIVE_SEVERITY_BUDGET"
+POLICY_LEVEL = "BASELINE_RELATIVE_BUDGET_V24912"
+EARLY_THROUGH_OUTER_CYCLE = 12
+EPS = 1.0e-12
+
+LEGACY_BINARY_CODES = {
+    "NEW_GEH40_COUNT_EXCEEDED",
+    "ABSOLUTE_GEH_CEILING_EXCEEDED",
+}
+
+
+def _f(value: Any, default: float = 0.0) -> float:
+    try:
+        return float(value)
+    except Exception:
+        return default
+
+
+def _i(value: Any, default: int = 0) -> int:
+    try:
+        return int(value)
+    except Exception:
+        return default
+
+
+def _relative_degradation(before: Any, after: Any) -> float:
+    b = _f(before)
+    a = _f(after)
+    if b <= EPS:
+        return 0.0 if a <= b + EPS else float("inf")
+    return max(0.0, (a - b) / b)
+
+
+def rebase_severity_guard_v24912(
+    guard: Mapping[str, Any],
+    severity_policy: Mapping[str, Any],
+    scoped_policy: Mapping[str, Any],
+) -> Dict[str, Any]:
+    """Reinterpret V2496 exploratory severity diagnostics under V24912.
+
+    V2496 has already calculated the authoritative before/after GEH values,
+    continuous severity scores and transition rows.  We deliberately reuse
+    those diagnostics instead of creating a parallel measurement path.
+    """
+    out: Dict[str, Any] = deepcopy(dict(guard))
+    if str(severity_policy.get("policy_level", "")).upper() != POLICY_LEVEL:
+        return out
+
+    max_single = _f(severity_policy.get("max_single_profile_geh_increase"), 15.0)
+    high_threshold = _f(severity_policy.get("high_geh_threshold"), 60.0)
+    max_high_delta = _f(severity_policy.get("max_high_geh_increase"), 10.0)
+    max_s20 = _f(scoped_policy.get("max_severity20_relative_degradation"), 0.0)
+    max_s30 = _f(scoped_policy.get("max_severity30_relative_degradation"), 0.0)
+    max_ge40 = _i(scoped_policy.get("max_geh40_net_count_increase"), 0)
+
+    before = out.get("before_severity") if isinstance(out.get("before_severity"), Mapping) else {}
+    after = out.get("after_severity") if isinstance(out.get("after_severity"), Mapping) else {}
+    s20_deg = _relative_degradation(before.get("severity20"), after.get("severity20"))
+    s30_deg = _relative_degradation(before.get("severity30"), after.get("severity30"))
+    geh40_net = max(0, _i(after.get("geh_ge40")) - _i(before.get("geh_ge40")))
+
+    # The old absolute-ceiling diagnostic contains every CAL profile whose
+    # *after* GEH is above the threshold.  Under V24912 its existence is not a
+    # veto: only a material delta while the after-state is high is hard.
+    high_rows: List[Dict[str, Any]] = []
+    high_delta_violations: List[Dict[str, Any]] = []
+    new_high_crossings: List[Dict[str, Any]] = []
+    for raw in out.get("absolute_geh_ceiling_violations") or []:
+        if not isinstance(raw, Mapping):
+            continue
+        row = dict(raw)
+        bg = _f(row.get("before_geh"))
+        ag = _f(row.get("after_geh"))
+        inc = _f(row.get("geh_increase"), ag - bg)
+        if ag > high_threshold + EPS:
+            high_rows.append(row)
+            if bg <= high_threshold + EPS:
+                new_high_crossings.append(row)
+            if inc > max_high_delta + EPS:
+                high_delta_violations.append(row)
+
+    # Keep any old hard code that V24912 did not explicitly replace.
+    violations = [
+        str(code) for code in (out.get("violation_codes") or [])
+        if str(code) not in LEGACY_BINARY_CODES
+    ]
+    if s20_deg > max_s20 + EPS:
+        violations.append("V24912_SEVERITY20_BUDGET_EXCEEDED")
+    if s30_deg > max_s30 + EPS:
+        violations.append("V24912_SEVERITY30_BUDGET_EXCEEDED")
+    if geh40_net > max_ge40:
+        violations.append("V24912_GEH40_NET_COUNT_BUDGET_EXCEEDED")
+    if high_delta_violations:
+        violations.append("V24912_HIGH_GEH_DELTA_BUDGET_EXCEEDED")
+
+    # Defensive re-check: V2496 already emits this hard code, but V24912 pins
+    # it independently in case an older diagnostic payload is replayed.
+    single = []
+    for raw in out.get("single_profile_geh_increase_violations") or []:
+        if isinstance(raw, Mapping):
+            row = dict(raw)
+            if _f(row.get("geh_increase"), _f(row.get("after_geh")) - _f(row.get("before_geh"))) > max_single + EPS:
+                single.append(row)
+    if single:
+        violations.append("SINGLE_PROFILE_GEH_INCREASE_EXCEEDED")
+
+    warnings = [str(x) for x in (out.get("warning_codes") or [])]
+    if out.get("new_geh40"):
+        warnings.append("V24912_GEH40_TRANSITION_WITHIN_NET_BUDGET")
+    if new_high_crossings and not high_delta_violations:
+        warnings.append("V24912_GEH60_THRESHOLD_CROSSING_DIAGNOSTIC_ONLY")
+    if high_rows:
+        warnings.append("V24912_EXISTING_HIGH_GEH_BASELINE_RELATIVE")
+
+    violations = sorted(set(violations))
+    warnings = sorted(set(warnings))
+    out.update({
+        "passes": not violations,
+        "mode": "EARLY_EXPLORATION_BASELINE_RELATIVE_SEVERITY_V24912",
+        "violation_codes": violations,
+        "warning_codes": warnings,
+        "severity20_relative_degradation": s20_deg,
+        "severity30_relative_degradation": s30_deg,
+        "geh40_net_count_increase": geh40_net,
+        "new_geh60": new_high_crossings,
+        "high_geh_rows": high_rows,
+        "high_geh_delta_violations": high_delta_violations,
+        "v24912_policy": {
+            "policy_id": POLICY_ID,
+            "policy_level": POLICY_LEVEL,
+            "baseline_relative": True,
+            "threshold_crossing_is_not_automatic_reject": True,
+            "severity20_relative_degradation": s20_deg,
+            "severity20_budget": max_s20,
+            "severity30_relative_degradation": s30_deg,
+            "severity30_budget": max_s30,
+            "geh40_net_count_increase": geh40_net,
+            "geh40_net_count_budget": max_ge40,
+            "high_geh_threshold": high_threshold,
+            "max_high_geh_increase": max_high_delta,
+            "high_geh_delta_violation_count": len(high_delta_violations),
+            "new_high_threshold_crossing_count": len(new_high_crossings),
+            "max_single_profile_geh_increase": max_single,
+        },
+    })
+    return out
+
+
+__all__ = [
+    "POLICY_ID", "POLICY_LEVEL", "EARLY_THROUGH_OUTER_CYCLE",
+    "rebase_severity_guard_v24912",
+]
