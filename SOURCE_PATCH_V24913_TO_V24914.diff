+                    if control is not None:
+                        control.finish(result.get("status", "FINISHED"), accepted_count=result.get("accepted_count"))
+                finally:
+                    rt.Visum = prior_runtime_visum
+                    supply_runtime.base.Visum = prior_base_visum
