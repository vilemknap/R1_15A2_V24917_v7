+        {"zone_no": 4, "family": "WORK", "role": "PROD", "log_step": pstep,
+         "base_margin_volume": 1000.0, "guided_margin_delta": total / 2,
+         "projected_margin_delta": total / 2},
+        {"zone_no": 1, "family": "WORK", "role": "ATT", "log_step": step1,
