+class EnumerationOnly:
+    def __init__(self, values):
+        self.values = values
+
+    @property
+    def GetAll(self):
+        return tuple(self.values)
+
+
+class PropertyOnlyParameters:
+    def __init__(self, b, c):
+        self.PARA_B = b
+        self.PARA_C = c
+
+    def AttValue(self, name):
+        raise AttributeError(name)
