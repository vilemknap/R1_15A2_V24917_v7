+def test_repeatedly_nested_failed_runs_choose_outermost_project_base(tmp_path):
+    module = load_launcher()
+    project = tmp_path / "project"
+    outer = project / "R1_15A2_V2481_RUNS"
+    inner = (outer / "RUN_OLD" / "CALIBRATION" / "CHECKPOINTS" /
