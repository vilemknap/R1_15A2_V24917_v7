+    _require(generation.get("role_balance_policy") ==
+             "ATTENUATE_ONLY_LARGER_IMPLEMENTABLE_PA_SIDE",
+             "V2486_GENERATION_ROLE_BALANCE_POLICY_CHANGED")
+    _require(generation.get("opposite_sign_policy") ==
