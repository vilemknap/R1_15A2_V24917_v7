+    r3 = r2 / "RUN_B" / "CALIBRATION" / "CHECKPOINTS" / "R1_15A2_V2484_RUNS"
+    source = _write_source(r3 / "RUN_C" / "CALIBRATION" / "CHECKPOINTS" / "ACCEPTED.ver")
+    layout = module._stable_project_layout(source)
