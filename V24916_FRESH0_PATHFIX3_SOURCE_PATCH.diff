+def critical_runtime_read_csv_auto(path):
+    for delimiter in (";", ","):
+        try:
+            with _OPEN(
+                _native_path(path), "r", encoding="utf-8-sig", newline=""
+            ) as stream:
+                rows = [dict(row) for row in csv.DictReader(stream, delimiter=delimiter)]
+            if rows and len(rows[0]) > 1:
+                return rows
+        except Exception:
+            pass
+    return []
