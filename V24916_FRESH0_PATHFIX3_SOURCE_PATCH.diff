+    if len(observations) != CURRENT_PROFILE_COUNT:
+        raise RuntimeError("CURRENT_COUNTLOCATION_AUTHORITY_ROW_COUNT:%d" % len(observations))
+    if len({x["no"] for x in observations}) != CURRENT_PROFILE_COUNT:
