+    with pytest.raises((ValueError, RuntimeError), match='EPOCH_RESULT_MISMATCH|COMPLETED_ASSIGNMENT_REQUIRED'):
+        wire.wrap_dynamic_realization(native)(bridge)
+    assert outer._long_incidence_assignment_binding == old
