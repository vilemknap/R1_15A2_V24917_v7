+    assert r['source_file_unchanged'] and source.read_bytes()==b'ORIGINAL_USER_FILE_MUST_NOT_CHANGE'
+    assert Path(r['final_accepted_version']['path']).name=='FINAL_CALIBRATED_WORKING_COPY.ver'
