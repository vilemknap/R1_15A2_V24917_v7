+    after = [_row("DRIVER", 49.99), _row("EDGE", 20.08)]
+    assert core.early_exploration_policy(cfg, "GENERATION") is None
+    decision = core.acceptance_decision(before, after, {}, {}, cfg, "GENERATION")
