+    monkeypatch.setattr(module.rt, "save_version", stop_after_root)
+    result = module._main_impl()
+    assert result["status"] == "FULL_OVERNIGHT_FAILED"
+    assert "TEST_STOP_AFTER_RUN_ROOT_EVIDENCE" in result["error"]
