+def _realize_finecdf_td(adapter, cfg, folder, control, before, baseline_diag, target_rows):
+    """Realize the FineCDF best state through the full downstream sequence.
+
+    Native 20B/IPF non-convergence is treated as a step-size failure, not as a
+    reason to relax its tolerance.  Smaller parameter steps are attempted from
+    the same accepted parent.  Any other error remains fail-closed.
